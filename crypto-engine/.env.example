# Environment template. Copy to .env (git-ignored). No secrets are required for
# public market data. Do NOT commit real values.

# MIE_CONFIG_FILE=config/engine.toml
# MIE_LOG_LEVEL=INFO
# MIE_DATA_SOURCE=LIVE
# MIE_BINANCE__WS_BASE_URL=wss://data-stream.binance.vision
# MIE_BINANCE__REST_BASE_URL=https://data-api.binance.vision
# MIE_UNIVERSE__MAX_SYMBOLS=60
# MIE_API__HOST=0.0.0.0
# MIE_API__PORT=8080
# MIE_RECORDING__ENABLED=false

# Reserved for a future, explicitly enabled execution phase (Testnet first).
# Keys must be trade-only (withdrawals disabled, IP-restricted) and are never logged.
# MIE_BINANCE_TESTNET_API_KEY=
# MIE_BINANCE_TESTNET_API_SECRET=
