{
  "author": {
    "name": "Peter Kekpe",
    "handle": "@peter-kekpe",
    "avatar": "brand/assets/avatar.png"
  },
  "series": "Backend Engineering",
  "note": "Colours sampled directly from the reference cover art (tools/source/reference-cover.png).",
  "formats": {
    "portrait": {
      "w": 1080,
      "h": 1350,
      "pad": "96px 84px",
      "use": "LinkedIn, Instagram, Facebook — 4:5 is the tallest each feed renders without cropping"
    },
    "story": {
      "w": 1080,
      "h": 1920,
      "pad": "200px 96px 470px",
      "use": "TikTok photo carousel — 9:16. Bottom padding clears TikTok's caption and action-rail overlay"
    },
    "square": {
      "w": 1080,
      "h": 1080,
      "pad": "84px",
      "use": "Fallback 1:1. Safe everywhere, but gives up feed height on LinkedIn/IG/FB"
    }
  },
  "color": {
    "ink": "#05060f",
    "inkSoft": "#3f4455",
    "muted": "#6b7186",
    "navy": "#001060",
    "navySoft": "#3a49a0",
    "lavender": "#e0e0f0",
    "lavenderSoft": "#eceCf8",
    "paper": "#ffffff",
    "cream": "#fbf8f1",
    "marker": "#ffe14d",
    "gold": "#b08d2e",
    "blue": "#2563eb",
    "green": "#1a7f4b",
    "greenSoft": "#e6f4ec",
    "red": "#c0392b",
    "redSoft": "#fcecea",
    "rule": "#dcdfea"
  },
  "font": {
    "display": "Inter",
    "mono": "JetBrains Mono",
    "serif": "Source Serif 4",
    "hand": "Caveat"
  },
  "platforms": {
    "linkedin": {
      "format": "portrait",
      "pdf": true,
      "note": "Carousels post as a PDF document. Slides also exported as PNGs."
    },
    "instagram": {
      "format": "portrait",
      "note": "Carousel post, up to 20 images."
    },
    "facebook": {
      "format": "portrait",
      "note": "Carousel post."
    },
    "tiktok": {
      "format": "story",
      "note": "Photo carousel, up to 35 images."
    }
  },
  "defaultFormats": [
    "portrait",
    "story"
  ]
}
